# ============================================================================
# wizard-ahe environment template
# Usage: cp .env.example .env and fill in real values. .env is gitignored.
# `ahe setup` can write this file for you.
# ============================================================================

# ---- Primary LLM (required) ------------------------------------------------
# Any OpenAI-compatible endpoint: local llama-server, a cloud API, or one of
# the OAuth proxies in scripts/ (see docs/WIZARD-AHE.md appendix). Referenced
# by configs/base.yaml and configs/experiments/exp-wizard*.yaml.
LLM_BASE_URL="http://localhost:8080/v1"
LLM_API_KEY="sk-noauth-local"      # any non-empty string for keyless local servers
LLM_MODEL="your-model-name"

# ---- wizard (agent-under-test) ----------------------------------------------
# Endpoint as seen from INSIDE the task containers (host "localhost" is not
# visible there — use host.docker.internal or the docker bridge IP).
WIZARD_LLM_BASE_URL="http://host.docker.internal:8080/v1"
# Host path to the static musl wizard binary uploaded into each container.
# WIZARD_BINARY="/path/to/wizard/target/x86_64-unknown-linux-musl/release/wizard"

# ---- ADB debugger LLM (optional; configs/base.yaml agent_debugger.llm) ------
# Falls back to LLM_* when unset; set separately to use a stronger model.
# ADB_LLM_API_KEY=""
# ADB_LLM_BASE_URL=""

# ---- E2B sandbox (only if harbor.env is set to "e2b"; local Docker needs none)
# E2B_API_KEY=""
# E2B_API_URL=""
# E2B_DOMAIN=""
# E2B_SANDBOX_TIMEOUT=3600

# ---- GitHub access (optional; some nexau install paths clone via token) -----
# GITHUB_TOKEN=""

# ---- Web search (evolve_agent's web_search tool) -----------------------------
# SERPER_API_KEY=""

# ---- HTML parsing (optional enhancement for evolve_agent's web_fetch) --------
# All three required to enable; otherwise falls back to plain fetching.
# BP_HTML_PARSER_URL=""
# BP_HTML_PARSER_API_KEY=""
# BP_HTML_PARSER_SECRET=""

# ---- Langfuse observability (optional) ---------------------------------------
# LANGFUSE_SECRET_KEY=""
# LANGFUSE_PUBLIC_KEY=""
# LANGFUSE_HOST=""
# LANGFUSE_BASE_URL=""

# ---- Feishu notifications (optional; configs/base.yaml notify.feishu_webhook)
# FEISHU_WEBHOOK="https://open.feishu.cn/open-apis/bot/v2/hook/xxxxx"
